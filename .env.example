# Supabase Database & Auth (Client-side)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ArtoPay Official Payment Gateway (Server-side Credentials — Never expose to client)
# Mode: 'sandbox' or 'production'
ARTOPAY_ENV=sandbox

# Official Base URL:
# Sandbox: https://api-sandbox.arto-pay.com
# Production: https://api.arto-pay.com
ARTOPAY_BASE_URL=https://api-sandbox.arto-pay.com

# Dedicated Webhook Secret for HMAC-SHA256 signature verification (docs.arto-pay.com)
ARTOPAY_WEBHOOK_SECRET=

# Secret Key for Backend API calls (starts with sk_...)
ARTOPAY_SECRET_KEY=

# Private Key (if gateway uses pk_... key)
ARTOPAY_PRIVATE_KEY=


# Optional Business Unit UUID (if multiple units under merchant account)
ARTOPAY_BUSINESS_UNIT_ID=

# Merchant Webhook callback endpoint registered at ArtoPay dashboard
ARTOPAY_WEBHOOK_URL=https://your-domain.com/api/payment/artopay-webhook

# Public return URL where customer is redirected after completing payment on ArtoPay
APP_URL=https://your-domain.com

# Development Payment Simulation Control
# Set to 'false' in production deployment to disable the test simulation button
ENABLE_PAYMENT_SIMULATION=true